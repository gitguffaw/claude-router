{
  "name": "claude-router",
  "displayName": "Claude Router",
  "version": "2.5.2",
  "description": "Route host-agent work through the local Claude CLI with live model discovery, reliable jobs, and explicit policy controls.",
  "author": {
    "name": "Compound"
  },
  "homepage": "https://github.com/gitguffaw/claude-router#readme",
  "repository": "https://github.com/gitguffaw/claude-router",
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agy",
    "models",
    "review",
    "delegation"
  ],
  "mcpServers": {
    "claude-router": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/claude-router-mcp.mjs"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "tool_timeout_sec": 2100
    }
  }
}
