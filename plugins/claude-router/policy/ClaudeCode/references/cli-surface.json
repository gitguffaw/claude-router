{
  "tool": "claude",
  "product": "Claude Code",
  "verified_on": "2026-08-14",
  "local_version": "2.1.232",
  "authority": {
    "runtime_command": "claude --help",
    "dynamic_fields": true,
    "dynamic_model_values": true,
    "dynamic_effort_values": true,
    "dynamic_permission_values": true,
    "model_help_completeness": "documented-examples",
    "rule": "The installed CLI owns native fields and values. This reference contains router policy and explanatory snapshots only; it is never an allowlist."
  },
  "provenance": {
    "local_commands": [
      "claude --version",
      "claude --help",
      "claude auth status",
      "claude agents",
      "claude mcp list",
      "claude plugin list"
    ],
    "official_docs": {
      "cli_reference": "https://code.claude.com/docs/en/cli-usage",
      "programmatic_usage": "https://code.claude.com/docs/en/headless",
      "authentication": "https://code.claude.com/docs/en/authentication",
      "permission_modes": "https://code.claude.com/docs/en/permission-modes",
      "mcp": "https://code.claude.com/docs/en/mcp",
      "plugins": "https://code.claude.com/docs/en/plugins-reference",
      "chrome": "https://code.claude.com/docs/en/chrome",
      "ultrareview": "https://code.claude.com/docs/en/ultrareview"
    }
  },
  "verified_environment": {
    "logged_in": true,
    "auth_method": "claude.ai",
    "api_provider": "firstParty",
    "subscription_type": "max",
    "notes": "Informational snapshot only. Re-check the live environment before promising availability."
  },
  "auth_isolation": {
    "oauth": {
      "claude_flag": "--safe-mode",
      "router_profile": "--lean=oauth",
      "behavior": "Disables customizations while normal auth, model selection, built-in tools, and permissions remain available."
    },
    "api": {
      "claude_flag": "--bare",
      "router_profile": "--lean=api",
      "behavior": "Skips ambient customizations, OAuth, and keychain reads. Requires ANTHROPIC_API_KEY, apiKeyHelper, or supported provider credentials."
    },
    "auto": {
      "router_profile": "--lean",
      "behavior": "Detect the active auth path and select OAuth safe mode or API bare mode."
    },
    "conflict": "Never combine --safe-mode and --bare."
  },
  "lean_defaults": {
    "system_prompt": "You are a concise expert coding assistant.",
    "read_only_tools": "Bash,Read",
    "exec_tools": "Bash,Read,Edit,Write",
    "override_rule": "Explicit --system-prompt and --tools values win."
  },
  "router_policy": {
    "read_only_modes": [
      "analyze",
      "plan",
      "review",
      "adversarial-review"
    ],
    "read_only_permission_mode": "plan",
    "write_mode": "exec",
    "dangerous_permission_bypass_requires": "--allow-dangerous",
    "raw_configuration_mutation_requires": "--allow-mutating",
    "future_command_default": "guarded-unclassified",
    "review_auto_fix": false,
    "generic_native_web_search_command": false
  },
  "capability_groups": {
    "managed_work": [
      "analyze",
      "plan",
      "exec",
      "review",
      "adversarial-review",
      "ultrareview"
    ],
    "live_discovery": [
      "models",
      "surface",
      "help"
    ],
    "job_lifecycle": [
      "status",
      "result",
      "cancel"
    ],
    "full_surface": [
      "raw",
      "cli"
    ]
  },
  "compatibility_controls": {
    "controls": [
      "--best",
      "--sonnet",
      "--opus",
      "--haiku",
      "--long-context",
      "--ultrathink"
    ],
    "rule": "Legacy router conveniences only. Do not treat them as the current Claude model or capability registry. Prefer explicit live native selectors and fields."
  },
  "skill_paths": {
    "skill_root_resolution": "Paths resolve relative to the ClaudeCode skill directory.",
    "print_wrapper": "scripts/claude_print.py",
    "interactive_workflow": "Workflows/InteractiveSession.md",
    "print_workflow": "Workflows/PrintMode.md",
    "extensibility_workflow": "Workflows/Extensibility.md"
  }
}
